{
  "name": "egaldeutsch-serverless",
  "version": "1.0.0",
  "description": "Learning German platform with quiz functionality",
  "scripts": {
    "develop": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "type-check": "tsc --noEmit",
    "dev": "netlify dev",
    "dev:functions": "netlify functions:serve",
    "build:functions": "go build -o netlify/functions/stories/stories ./netlify/functions/stories && go build -o netlify/functions/quiz/quiz ./netlify/functions/quiz && go build -o netlify/functions/health/health ./netlify/functions/health",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:creator": "playwright test tests/e2e/creator-workflow.spec.ts",
    "test:e2e:admin": "playwright test tests/e2e/admin-workflow.spec.ts",
    "test:e2e:lifecycle": "playwright test tests/e2e/complete-lifecycle.spec.ts",
    "test:e2e:auth": "playwright test tests/e2e/auth-workflows.spec.ts",
    "test:e2e:user-mgmt": "playwright test tests/e2e/admin-user-management.spec.ts",
    "test:e2e:stories": "playwright test tests/e2e/story-workflows.spec.ts",
    "test:e2e:questions": "playwright test tests/e2e/question-quiz-workflows.spec.ts",
    "test:e2e:errors": "playwright test tests/e2e/error-handling.spec.ts",
    "test:e2e:roles": "playwright test tests/e2e/role-based-crud-workflows.spec.ts",
    "test:e2e:cross-role": "playwright test tests/e2e/cross-role-scenarios.spec.ts",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gatsby": "^5.12.0",
    "gatsby-plugin-alias-imports": "^1.0.5",
    "gatsby-plugin-manifest": "^5.15.0",
    "lucide-react": "^0.553.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@netlify/plugin-gatsby": "^3.8.4",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/typography": "^0.5.10",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "gatsby-plugin-postcss": "^6.12.0",
    "gatsby-plugin-typescript": "^5.12.0",
    "netlify-cli": "^23.10.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0"
  }
}
